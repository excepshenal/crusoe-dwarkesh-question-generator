# Copy to .env and `set -a; source .env; set +a` before running anything.
# ONE shared key for the Crusoe inference endpoint — used everywhere by default.
CRUSOE_API_KEY=

# Each role is an OpenAI-compatible endpoint (base_url + model). The key defaults to
# CRUSOE_API_KEY above; set a per-role *_API_KEY only to override (e.g. an Anthropic
# key for a Claude-backed role).

# --- GENERATOR: the model under test. ---
GENERATOR_BASE_URL=https://api.inference.crusoecloud.com/v1
GENERATOR_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507

# --- JUDGE: the LLM-as-judge. ---
JUDGE_BASE_URL=https://api.inference.crusoecloud.com/v1
JUDGE_MODEL=zai/GLM-5.1

# --- RESEARCH: model used to bootstrap guest research (Claude by default). ---
RESEARCH_BASE_URL=https://api.anthropic.com/v1/
RESEARCH_MODEL=claude-opus-4-8

# Optional per-role key overrides, and an Anthropic key for Claude-backed roles.
# GENERATOR_API_KEY=
# JUDGE_API_KEY=
# RESEARCH_API_KEY=
ANTHROPIC_API_KEY=

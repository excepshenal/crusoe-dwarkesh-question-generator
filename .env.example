# Copy to .env and `set -a; source .env; set +a` before running generate/evaluate.
# Each role is an OpenAI-compatible endpoint (base_url + model + key).

# --- GENERATOR: the model under test. Set when you provide the inference endpoint. ---
GENERATOR_BASE_URL=
GENERATOR_API_KEY=
GENERATOR_MODEL=

# --- JUDGE: the calibrated LLM-as-judge (Claude by default). ---
JUDGE_BASE_URL=https://api.anthropic.com/v1/
JUDGE_API_KEY=
JUDGE_MODEL=claude-opus-4-8

# --- RESEARCH: model used to bootstrap guest research (Claude by default). ---
RESEARCH_BASE_URL=https://api.anthropic.com/v1/
RESEARCH_API_KEY=
RESEARCH_MODEL=claude-opus-4-8

# Fallback for any *_API_KEY left blank above.
ANTHROPIC_API_KEY=
